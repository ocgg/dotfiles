// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "mode": [
          "plan"
        ]
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "scrollbar": {
    "cursors": true
  },
  "cursor_shape": "bar",
  "cursor_blink": false,
  "buffer_line_height": "comfortable",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "terminal": {
    "dock": "right",
    "font_size": 16.0,
    "font_family": "JetBrainsMonoNL Nerd Font Mono"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "show_turn_stats": true,
    "default_profile": "write",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.3-codex",
      "enable_thinking": true,
      "effort": "low"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "minimap": {
    "show": "auto"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "buffer_font_features": {
    "calt": 0
  },
  "format_on_save": "off",
  "inlay_hints": {
    "enabled": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  }
}
