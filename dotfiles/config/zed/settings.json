// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "completions": {
    "words": "enabled",
    "words_min_length": 3,
  },
  "lsp": {
    "solargraph": {
      "initialization_options": {
        "diagnostics": true,
        "formatting": true
      }
    }
  },
  "languages": {
    "Slim": {
      "language_servers": ["!ruby-lsp", "tailwindcss-language-server", "..."],
      "tab_size": 2
    },
  },
  "context_servers": {
    "mcp-server-godot": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "show_wrap_guides": true,
  "which_key": {
    "enabled": true
  },
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "relative_line_numbers": "disabled",
  "agent_servers": {
    "mistral-vibe": {
      "default_config_options": {
        "thinking": "max",
        "mode": "plan"
      },
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "mode": "build",
        "model": "openai/gpt-5.4-mini"
      },
      "favorite_config_option_values": {
        "mode": [
          "plan"
        ]
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "default",
        "mode": "default",
        "model": "default"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "scrollbar": {
    "cursors": true
  },
  "cursor_shape": "bar",
  "cursor_blink": false,
  "buffer_line_height": "comfortable",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "terminal": {
    "dock": "right",
    "font_size": 16.0,
    "font_family": "JetBrainsMonoNL Nerd Font Mono"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "create_thread": true,
          "diagnostics": true,
          "fetch": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "search_web": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-godot": {
            "tools": {
              "stop_project": false,
              "run_project": false,
              "list_projects": true,
              "get_uid": true,
              "get_project_info": true,
              "get_godot_version": true,
              "get_debug_output": true
            }
          }
        }
      }
    },
    "show_turn_stats": true,
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "minimap": {
    "show": "never"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "buffer_font_features": {
    "calt": 0
  },
  "format_on_save": "off",
  "inlay_hints": {
    "enabled": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  }
}
